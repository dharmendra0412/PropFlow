{
  "name": "realtime-property-rental-amenity-platform",
  "version": "1.0.0",
  "description": "Real-Time Property Rental, Maintenance & Amenity Management Platform",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "seed": "node server/src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "keywords": [
    "property-management",
    "real-time",
    "maintenance-tracking",
    "amenity-booking",
    "socket.io",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
